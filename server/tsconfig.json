{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "types": ["jest", "node"],
    "resolveJsonModule": true
  },
  "include": ["./src/**/*", "./tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
