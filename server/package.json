{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
  "build": "tsc",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/models tests/auth --verbose",
    "test:integration": "jest tests/integration --verbose",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "start": "node dist/index.js",
    "dev": "ts-node-dev src/index.ts",
    "dev:background": "ts-node-dev --respawn --transpile-only src/index.ts & echo $! > .pidfile",
    "stop": "kill $(cat .pidfile) && rm .pidfile",
    "seed": "ts-node scripts/seed-data.ts",
    "import:real": "node scripts/import-real-dump.js",
    "clean:test-data": "node scripts/clean-test-data.js",
    "import:csv": "node scripts/import-csv-data.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@types/handlebars": "^4.0.40",
    "@types/multer": "^1.4.13",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "multer": "^2.0.1",
    "node-cron": "^4.1.0",
    "nodemailer": "^7.0.3",
    "puppeteer": "^24.11.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^22.18.1",
    "@types/nodemailer": "^6.4.17",
    "@types/puppeteer": "^5.4.7",
    "@types/supertest": "^7.2.0",
    "jest": "^30.2.0",
    "mongodb-memory-server": "^11.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.2"
  }
}
